{
  "video_extraction": {
    "fps": 1.0,
    "_comment": "Higher FPS for more frames and better temporal continuity"
  },
  "colmap": {
    "feature_extractor": {
      "ImageReader.single_camera_per_folder": 1,
      "ImageReader.camera_model": "SIMPLE_RADIAL",
      "SiftExtraction.max_num_features": 32768,
      "SiftExtraction.first_octave": -1,
      "SiftExtraction.peak_threshold": 0.0033,
      "SiftExtraction.edge_threshold": 10,
      "_comment": "More features, SIMPLE_RADIAL often works better than OPENCV"
    },
    "matcher": {
      "type": "sequential",
      "SiftMatching.max_ratio": 0.9,
      "SiftMatching.max_distance": 0.9,
      "SiftMatching.max_num_matches": 32768,
      "SequentialMatching.overlap": 20,
      "SequentialMatching.loop_detection": 1,
      "_comment": "Sequential matcher better for video, higher overlap"
    },
    "mapper": {
      "Mapper.multiple_models": 0,
      "Mapper.ba_global_max_num_iterations": 100,
      "Mapper.ba_local_max_num_iterations": 50,
      "Mapper.init_min_num_inliers": 15,
      "Mapper.init_max_error": 12,
      "Mapper.init_min_tri_angle": 0.5,
      "Mapper.abs_pose_min_num_inliers": 10,
      "Mapper.abs_pose_min_inlier_ratio": 0.05,
      "Mapper.filter_min_tri_angle": 0.5,
      "Mapper.tri_min_angle": 0.5,
      "Mapper.max_reg_trials": 5,
      "_comment": "Very relaxed registration, single model, more retries"
    }
  },
  "postshot": {
    "train_iterations": 50000
  }
}

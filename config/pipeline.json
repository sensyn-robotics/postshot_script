{
  "pipeline": {
    "overwrite_result": false,
    "test_data_path": "C:\\postshot_test_data"
  },
  "input": {
    "scene_path": "",
    "video_w": "video_W.mp4",
    "video_z": "video_Z.mp4"
  },
  "output": {
    "dir_name": "output",
    "images_subdir": "images",
    "colmap_subdir": "colmap",
    "postshot_subdir": "postshot",
    "visualizations_subdir": "visualizations"
  },
  "paths": {
    "ffmpeg": "C:\\ffmpeg\\bin\\ffmpeg.exe",
    "colmap": "C:\\COLMAP\\COLMAP.bat",
    "postshot_cli": "C:\\Program Files\\Jawset Postshot\\bin\\postshot-cli.exe",
    "python": "python",
    "temp": "C:\\Postshot_Temp"
  },
  "stage_01_extract": {
    "fps": 2,
    "target_frames": 0,
    "format": "png",
    "quality": 2
  },
  "stage_02_filter": {
    "enabled": false
  },
  "stage_03_features": {
    "camera_model": "SIMPLE_RADIAL",
    "single_camera": true,
    "single_camera_per_folder": false,
    "max_features": 16384
  },
  "stage_04_matching": {
    "type": "sequential",
    "sequential_overlap": 20,
    "sequential_loop": true,
    "guided_matching": true,
    "sift_max_ratio": 0.8
  },
  "stage_05_mapper": {
    "multiple_models": true,
    "merge_models": false,
    "quality_gate": false,
    "filter_degenerate_pairs": true,
    "min_model_size": 10,
    "ba_global_max_iterations": 100,
    "ba_local_max_iterations": 25,
    "init_min_num_inliers": 50,
    "abs_pose_min_num_inliers": 15,
    "abs_pose_min_inlier_ratio": 0.15,
    "visualization_interval_minutes": 10
  },
  "stage_06_train": {
    "checkpoints": [10000, 30000],
    "profile": "Splat3",
    "save_visualization": false,
    "train_camera": "all",
    "anti_aliasing": true,
    "train_steps_limit": 0,
    "max_num_features": 16,
    "max_sh_degree": 3,
    "max_image_size": 3840,
    "show_train_error": true
  },
  "stage_07_export": {
    "format": "ply"
  }
}

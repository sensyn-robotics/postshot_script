        "postshot_subdir": "postshot",
        "visualizations_subdir": "visualizations"
    },
    "paths": {
        "ffmpeg": "C:\\ffmpeg\\bin\\ffmpeg.exe",
        "colmap": "C:\\COLMAP\\COLMAP.bat",

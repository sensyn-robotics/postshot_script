{
  "pipeline": {
    "overwrite_result": true,
    "test_data_path": "C:\\postshot_script\\data\\tower"
  },
  "input": {
    "scene_path": ""
  },
  "output": {
    "dir_name": "output",
    "images_subdir": "images",
    "colmap_subdir": "colmap",
    "postshot_subdir": "postshot",
    "visualizations_subdir": "visualizations"
  },
  "paths": {
    "ffmpeg": "C:\\ffmpeg\\bin\\ffmpeg.exe",
    "ffprobe": "C:\\ffmpeg\\bin\\ffprobe.exe",
    "colmap": "C:\\COLMAP\\COLMAP.bat",
    "postshot_cli": "C:\\Program Files\\Jawset Postshot\\bin\\postshot-cli.exe",
    "python": "python",
    "temp": "C:\\Postshot_Temp"
  },
  "stage_01_extract": {
    "fps": 1,
    "target_frames": 0,
    "format": "png",
    "quality": 2
  },
  "stage_02_filter": {
    "enabled": false,
    "blur_threshold": "auto",
    "target_overlap": 0.99,
    "max_frames": 600
  },
  "stage_03_features": {
    "camera_model": "SIMPLE_RADIAL",
    "single_camera": true,
    "single_camera_per_folder": false,
    "max_features": 8192
  },
  "stage_04_matching": {
    "type": "exhaustive",
    "overlap": 20,
    "sift_max_ratio": 0.8,
    "loop_detection": false,
    "loop_detection_period": 10,
    "loop_detection_num_images": 50,
    "guided_matching": false
  },
  "stage_05_mapper": {
    "multiple_models": true,
    "min_model_size": 10,
    "ba_global_max_iterations": 50,
    "ba_local_max_iterations": 25,
    "init_min_num_inliers": 100,
    "abs_pose_min_num_inliers": 30,
    "abs_pose_min_inlier_ratio": 0.25,
    "visualization_interval_minutes": 10
  },
  "stage_06_train": {
    "checkpoints": [10000, 30000, 50000, 70000, 100000],
    "profile": "Splat3",
    "save_visualization": true,
    "train_camera": "all",
    "anti_aliasing": true,
    "train_steps_limit": 30,
    "max_num_features": 8,
    "max_sh_degree": 3,
    "max_image_size": 3840,
    "show_train_error": true
  },
  "stage_07_export": {
    "format": "ply"
  },
  "quality_gate": {
    "min_ssim": 0.75,
    "max_lpips": 0.18,
    "retry_strategy": [
      {
        "name": "exhaustive_1fps",
        "description": "Exhaustive matcher, 1fps, 8192 features, strict SIFT",
        "fps": 1,
        "scale": 1.0,
        "max_features": 8192,
        "matcher_type": "exhaustive",
        "loop_detection": false,
        "guided_matching": false
      }
    ]
  }
}

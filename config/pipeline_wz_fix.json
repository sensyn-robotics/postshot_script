{
  "pipeline": {
    "overwrite_result": false,
    "test_data_path": "C:\\postshot_test_data"
  },
  "input": {
    "scene_path": "",
    "video_w": "video_W.mp4",
    "video_z": "video_Z.mp4"
  },
  "output": {
    "dir_name": "output",
    "images_subdir": "images",
    "colmap_subdir": "colmap",
    "postshot_subdir": "postshot",
    "visualizations_subdir": "visualizations"
  },
  "paths": {
    "ffmpeg": "C:\\ffmpeg\\bin\\ffmpeg.exe",
    "colmap": "C:\\COLMAP\\COLMAP.bat",
    "postshot_cli": "C:\\Program Files\\Jawset Postshot\\bin\\postshot-cli.exe",
    "python": "C:\\Users\\共通パソコンsfmPC⑦\\AppData\\Local\\Programs\\Python\\Python311\\python.exe",
    "temp": "C:\\Postshot_Temp"
  },
  "stage_01_extract": {
    "fps": 0.5,
    "format": "png",
    "quality": 2
  },
  "stage_02_filter": {
    "enabled": true,
    "blur_threshold": "auto",
    "target_overlap": 0.8,
    "max_frames": 400
  },
  "stage_03_features": {
    "camera_model": "SIMPLE_RADIAL",
    "single_camera_per_folder": true,
    "max_features": 16384,
    "_comment_features": "Doubled from 8192 for better W-Z cross-camera matching"
  },
  "stage_04_matching": {
    "type": "exhaustive",
    "_comment_matching": "Exhaustive required for W-Z cross-camera matching"
  },
  "stage_05_mapper": {
    "multiple_models": true,
    "min_model_size": 30,
    "ba_global_max_iterations": 50,
    "ba_local_max_iterations": 15,
    "init_min_num_inliers": 30,
    "abs_pose_min_num_inliers": 10,
    "abs_pose_min_inlier_ratio": 0.1,
    "visualization_interval_minutes": 10,
    "_comment_mapper": "Relaxed thresholds: min_model_size 50->30, init_min_num_inliers 50->30, abs_pose_min_num_inliers 15->10, abs_pose_min_inlier_ratio 0.15->0.1"
  },
  "stage_06_train": {
    "checkpoints": [5000, 10000, 30000],
    "profile": "Splat3",
    "save_visualization": true
  },
  "stage_07_export": {
    "format": "ply"
  }
}

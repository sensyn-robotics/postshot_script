{
  "pipeline": {
    "overwrite_result": true,
    "test_data_path": "C:\\postshot_script\\data\\tower"
  },
  "input": {
    "scene_path": ""
  },
  "output": {
    "dir_name": "output_v2",
    "images_subdir": "images",
    "colmap_subdir": "colmap",
    "postshot_subdir": "postshot",
    "visualizations_subdir": "visualizations"
  },
  "paths": {
    "ffmpeg": "C:\\ffmpeg\\bin\\ffmpeg.exe",
    "ffprobe": "C:\\ffmpeg\\bin\\ffprobe.exe",
    "colmap": "C:\\COLMAP\\COLMAP.bat",
    "postshot_cli": "C:\\Program Files\\Jawset Postshot\\bin\\postshot-cli.exe",
    "python": "python",
    "temp": "C:\\Postshot_Temp"
  },
  "stage_01_extract": {
    "fps": 3,
    "target_frames": 0,
    "format": "png",
    "quality": 2
  },
  "stage_02_filter": {
    "enabled": false
  },
  "stage_03_features": {
    "camera_model": "SIMPLE_RADIAL",
    "single_camera": true,
    "single_camera_per_folder": false,
    "max_features": 32768
  },
  "stage_04_matching": {
    "type": "exhaustive",
    "sift_max_ratio": 0.8,
    "loop_detection": false,
    "guided_matching": false
  },
  "stage_05_mapper": {
    "multiple_models": true,
    "merge_models": false,
    "quality_gate": false,
    "min_model_size": 10,
    "ba_global_max_iterations": 100,
    "ba_local_max_iterations": 25,
    "init_min_num_inliers": 100,
    "abs_pose_min_num_inliers": 30,
    "abs_pose_min_inlier_ratio": 0.25,
    "visualization_interval_minutes": 10
  },
  "stage_06_train": {
    "checkpoints": [10000, 30000],
    "profile": "Splat3",
    "save_visualization": false,
    "train_camera": "all",
    "anti_aliasing": true,
    "train_steps_limit": 0,
    "max_num_features": 16,
    "max_sh_degree": 3,
    "max_image_size": 3840,
    "show_train_error": true
  },
  "stage_07_export": {
    "format": "ply"
  }
}
